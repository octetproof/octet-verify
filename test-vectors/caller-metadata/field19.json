{
  "spec": "caller-metadata binding spec, phase B (LocationProof field 19)",
  "proto": "message CallerManifest { repeated CallerManifestEntry entries = 1; } message CallerManifestEntry { string key = 1; string content_type = 2; uint64 size = 3; bytes sha256 = 4; string locator = 5; }",
